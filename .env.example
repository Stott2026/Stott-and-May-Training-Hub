# Copy this file to .env (in the same folder) and fill in the values.
# Never commit .env to GitHub. It is already listed in .gitignore.

# ── Server ──────────────────────────────────────────────
# Port the Express server listens on. Railway sets this automatically in production.
PORT=3000

# "development" locally, "production" on Railway.
NODE_ENV=development

# ── Sanity (content) ────────────────────────────────────
# Your Sanity project ID. Find it at sanity.io/manage → your project → top of the page.
# Not a secret, but kept here so it lives in one place. Used by both the Studio and the server.
SANITY_STUDIO_PROJECT_ID=hhtep62l

# The dataset that holds the content. "production" unless you created a different one.
SANITY_STUDIO_DATASET=production

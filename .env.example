# Copy this file to .env (in the same folder) and fill in the values.
# Never commit .env to GitHub. It is already listed in .gitignore.

# ── Server ──────────────────────────────────────────────
# Port the Express server listens on. Railway sets this automatically in production.
PORT=3000

# "development" locally, "production" on Railway.
NODE_ENV=development

# The address people use to reach the hub, with no slash at the end.
# Locally: http://localhost:3000. On Railway: your Railway address, e.g. https://sm-training-hub.up.railway.app
# Microsoft sends people back to <BASE_URL>/auth/callback after sign-in, so IT must register that exact address.
BASE_URL=http://localhost:3000

# ── Microsoft sign-in (Entra ID) ─────────────────────────
# All four are needed. Until they are set, the hub shows "Sign-in isn't set up yet" to everyone.
# From IT's app registration in Microsoft Entra ID: "Application (client) ID" and "Directory (tenant) ID".
ENTRA_CLIENT_ID=
ENTRA_TENANT_ID=
# The client secret's "Value" (not its "Secret ID"). It expires: note the date IT gives you and ask for a new one before then.
ENTRA_CLIENT_SECRET=
# A long random string used to sign the sign-in cookie. Make one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Use a different one on Railway from your own computer. Changing it signs everyone out.
# People stay signed in for 7 days (renewed on each visit) and sign in again after 30 days: see server/auth.js.
SESSION_SECRET=

# LOCAL DEVELOPMENT ONLY, before IT's details arrive: sign everyone in as this name without Microsoft.
# Ignored unless NODE_ENV=development and the Entra settings above are empty. Never set it on Railway.
# DEV_SIGNIN_AS=Ian Barker

# ── Sanity (content) ────────────────────────────────────
# Your Sanity project ID. Find it at sanity.io/manage → your project → top of the page.
# Not a secret, but kept here so it lives in one place. Used by both the Studio and the server.
SANITY_STUDIO_PROJECT_ID=hhtep62l

# The dataset that holds the content. "production" unless you created a different one.
SANITY_STUDIO_DATASET=production

# Token the hub's server uses to read content (the dataset is private).
# Create it at sanity.io/manage → your project → API → Tokens → Add API token, with "Viewer" permission.
# Needed locally and on Railway. Never put it in the web/ folder: the browser must not see it.
SANITY_READ_TOKEN=

# The hosted Studio's web address: https://<this value>.sanity.studio
# Editors open this to change content. Change it before the first deploy if you want a different name.
SANITY_STUDIO_HOSTNAME=stottandmay-training

# Token used by `npm run studio:deploy` to publish the hosted Studio.
# Create it at sanity.io/manage → your project → API → Tokens → Add API token, with the "Deploy Studio" permission.
SANITY_AUTH_TOKEN=

# Token used by `npm run import:prototype` to write content into Sanity.
# Create it in the same place with "Editor" permission. Only needed when importing content.
SANITY_WRITE_TOKEN=

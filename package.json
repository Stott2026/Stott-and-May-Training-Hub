{
  "name": "sm-training-hub",
  "private": true,
  "description": "Stott and May Training Hub",
  "engines": {
    "node": ">=22.12"
  },
  "workspaces": [
    "web",
    "server",
    "studio"
  ],
  "scripts": {
    "dev": "concurrently -n server,studio -c cyan,magenta \"npm run dev -w server\" \"npm run dev -w studio\"",
    "dev:app": "npm run dev -w server",
    "dev:studio": "npm run dev -w studio",
    "build": "npm run build -w web",
    "start": "npm start -w server",
    "studio:deploy": "npm run deploy -w studio",
    "import:prototype": "npm run import:prototype -w studio --",
    "preview:build": "node --env-file-if-exists=.env scripts/build-preview.js",
    "import:playbook": "npm run import:playbook -w studio --",
    "import:playbook-01-09": "npm run import:playbook-01-09 -w studio --",
    "import:playbook-02-04": "npm run import:playbook-02-04 -w studio --",
    "import:playbook-03": "npm run import:playbook-03 -w studio --",
    "import:playbook-05-06": "npm run import:playbook-05-06 -w studio --",
    "import:playbook-10-11": "npm run import:playbook-10-11 -w studio --",
    "import:library": "npm run import:library -w studio --",
    "import:management": "npm run import:management -w studio --",
    "decks:install": "npm install --prefix scripts/decks",
    "decks": "node --env-file-if-exists=.env scripts/decks/build.mjs"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
